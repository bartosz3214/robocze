# Copy to .env and adjust:  cp .env.example .env

# --- Project ---------------------------------------------------------------
COMPOSE_PROJECT_NAME=bartek-robocze

# Host UID/GID used to build the PHP image, so files created inside the
# container belong to you.  Check with: id -u && id -g
APP_UID=1000
APP_GID=1000

# --- Nginx -----------------------------------------------------------------
# Port exposed on the host (container always listens on 80).
NGINX_PORT=80
# Document root *inside* the container. Change to /var/www/html/public
# for Symfony/Laravel-style layouts.
NGINX_ROOT=/var/www/html

# --- PHP -------------------------------------------------------------------
PHP_VERSION=8.5
# Directory on the host that is mounted as /var/www/html
APP_PATH=.
PHP_MEMORY_LIMIT=256M
PHP_UPLOAD_MAX_FILESIZE=32M
PHP_POST_MAX_SIZE=32M
PHP_MAX_EXECUTION_TIME=60
# Set to 0 in production
PHP_DISPLAY_ERRORS=1

# --- MySQL -----------------------------------------------------------------
MYSQL_VERSION=8.4
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=app
MYSQL_ROOT_PASSWORD=root
# Port exposed on the host (container always listens on 3306).
# Comment out the mysql "ports:" block in compose.yaml to keep it private.
MYSQL_PORT=3306

# Connection string for the app (host = the compose service name)
DATABASE_URL=mysql://app:app@mysql:3306/app
